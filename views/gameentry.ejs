<!DOCTYPE html>
<html lang="en">

<%- include('../templates/head') %>

<link rel="stylesheet" href="gameentry.css">
<style>
    body {
    background-image: url('/img/game.jpg'); 
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
}

.container-main {
    background-color: rgba(0, 0, 0, 0.5); 
    text-align: center;
    padding: 20px;
    border-radius: 10px;
    margin: auto;
    width: 50%;
}

.modal-body {
    padding: 20px;
    border-radius: 10px;
}

#pageTitle{
    color: #f39c12;
}

#username{
    color:#fff;
}

.modal-header h4 {
    color: #f39c12; 
}
</style>

<body>

    <div class="container mt-5 text-center container-main">

        <h1 id="pageTitle">SolarVille Gamified Entry</h1>
        <h1 id="username">Your Username</h1>
        <button id="collaborateBtn" class="btn btn-success mt-3">Collaborate</button>

    </div>

   
    <div class="modal" id="collaborateModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">
                    <h4 class="modal-title">Collaborate with a Fellow Solarian</h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>

     
                <div class="modal-body">

                    <form id="collaborateForm">

                        <div class="form-group">
                            <label for="userId1">Enter Your First Collaborator's ID</label>
                            <input type="text" class="form-control" id="userId1" required>
                        </div>

                        <div class="form-group">
                            <label for="userId1">Enter Your Second Collaborator's ID</label>
                            <input type="text" class="form-control" id="userId1" required>
                        </div>

                        <div class="form-group">
                            <label for="teamName">Enter Your Team Name</label>
                            <input type="text" class="form-control" id="teamName" required>
                        </div>

                        <a id="collaborateBtn" class="btn btn-success mt-3" href="/game">Submit</a>

                    </form>

                    <div class="mt-3">

                        <h5>Rules and Regulations</h5>

                        <ol>
                            <li>Collaborate with others to boost your team's performance.</li>
                            <li>Create a unique team name that reflects your collaboration.</li>
                            <li>Trade renewable energy certificates responsibly for points.</li>
                            <li>Earn points by active participation and sustainable practices.</li>
                            <li>Reach 500 points to unlock access to SolarVille.</li>
                            <li>Build your team by adding two users and progress to new challenges.</li>
                            <li>Complete SolarVille sections for high points and earn REC rewards.</li>
                            <li>Use REC to play and earn rewards if you have no points.</li>
                            <li>Earn points by topping the leaderboard, retiring REC, and daily logins.</li>
                        </ol>
                        

                    </div>

                </div>

            </div>
        </div>
    </div>

    

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
    <script src="/js/game.js"></script>

</body>

</html>
