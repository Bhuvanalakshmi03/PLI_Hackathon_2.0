<!DOCTYPE html>
<html lang="en">

  <%- include('../templates/head') %>

<body>

  <%- include('../templates/nav') %>

  <div class="section-title" style="margin-top: 150px;">

    <h2>REC's</h2>
    <p>Manage Your REC's</p>

</div>


  <div class="container mt-4">
    <div class="container" style="padding: 80px; background-color: #fff; box-shadow: 0 0 10px rgba(0, 128, 0, 0.3);">
      <table class="table">
        <thead>
            <tr>
            <th>ID</th>
            <th>Info</th>
            <th>Device Type</th>
            <th>Date</th>
            <th>Grid Operator</th>
            <th>MWh</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr class="custom-card">
            <td>1</td>
            <td>
              <span class="icon-container" data-toggle="collapse" data-target="#row1info" aria-expanded="false" aria-controls="row1info">
                <i class="fas fa-caret-down"></i>
              </span>
            </td>
            <td>Solar</td>
            <td>2024-02-09</td>
            <td>Singapore</td>
            <td>5</td>
            <td>Exchange</td>
            <td>
              <button class="btn btn-success" data-toggle="modal" data-target="#saleModal">+ SALE</button>
            </td>
          </tr>
          <tr id="row1info" class="collapse">
            <td colspan="8">
              <div class="card custom-card">
                <div class="card-body">
                  <p>Additional Information:</p>
                  <ul>
                    <li>Issue Date: 2024-02-09</li>
                    <li>Owner: John Doe</li>
                    <li>Total Counts: 200</li>
                    <!-- Add more information as needed -->
                  </ul>
                </div>
              </div>
            </td>
          </tr>
          <tr class="custom-card">
            <td>2</td>
            <td>
              <span class="icon-container" data-toggle="collapse" data-target="#row2info" aria-expanded="false" aria-controls="row2info">
                <i class="fas fa-caret-down"></i>
              </span>
            </td>
            <td>Solar</td>
            <td>2024-02-10</td>
            <td>Singapore</td>
            <td>150</td>
            <td>Exchange</td>
            <td>
              <button class="btn btn-success" data-toggle="modal" data-target="#saleModal">+ SALE</button>
            </td>
          </tr>
          <tr id="row2info" class="collapse">
            <td colspan="8">
              <div class="card custom-card">
                <div class="card-body">
                  <p>Additional Information:</p>
                  <ul>
                    <li>Issue Date: 2024-02-10</li>
                    <li>Owner: Jane Doe</li>
                    <li>Total Counts: 250</li>
                    <!-- Add more information as needed -->
                  </ul>
                </div>
              </div>
            </td>
          </tr>
          <!-- Add more rows as needed -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- Sale Modal -->
  <div class="modal fade" id="saleModal" tabindex="-1" role="dialog" aria-labelledby="saleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document" style="width: 60%; height: 50%;">
      <div class="modal-content" style="padding: 10px;">
        <div class="modal-header">
          <h5 class="modal-title text-center" id="saleModalLabel">Publish Certificate No for Sale</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body" style="padding: 10px;">
          <p>Facility</p>
          <p>Facility A</p>
          <hr>
          <p>Creation Time</p>
          <p>21.10.2023</p>
          <hr>
          <p>MWh</p>
          <p>3</p>
          <hr>
          <p>Price</p>
          <input id="price" type="text" value="0" style="border: none; outline: none;">
          <hr>
          <p>Currency</p>
          <select>
            <option value="USD">USD</option>
            <option value="EUR">EUR</option>
            <option value="GBP">GBP</option>
            <!-- Add more options as needed -->
          </select>
        </div>
        <div class="modal-footer">
          <button  type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
          <button id="sale" onclick="App.Sale()"  type="button" class="btn btn-success">Publish for Sale</button>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>

<script src="https://cdn.jsdelivr.net/npm/truffle-contract@4.0.31/dist/truffle-contract.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/web3/1.7.0-rc.0/web3.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.1/js/all.min.js"></script>

</body>
</html>
